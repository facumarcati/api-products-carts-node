<div class="detail-container">
  <h1 class="detail-title">{{product.title}}</h1>

  <div class="detail-card">
    <p class="detail-description">{{product.description}}</p>

    <div class="detail-info">
      <span>Categoría: <strong>{{product.category}}</strong></span>
      <span>Precio: <strong>${{formatPrice product.price}}</strong></span>
      <span>Stock: <strong>{{product.stock}}</strong></span>
    </div>

    <form method="POST" action="/carts/{{cartId}}/products/{{product._id}}">
      <input
        type="hidden"
        name="redirectTo"
        value="/products/{{product._id}}"
      />
      <button type="submit" class="btn-primary">Agregar al carrito</button>
    </form>

    <a href="/carts/{{cartId}}" class="btn-secondary">Ver carrito</a>

    <a href="/products" class="back-link">← Volver a productos</a>
  </div>
</div>

<script>
  const CART_ID = "{{cartId}}";
</script>