<div class="page-header">
  <span class="eyebrow"></span>
  <h1>Crear cuenta</h1>
</div>

<div class="page-nav">
  <a href="/" class="page-nav-link">
    ← Volver al inicio
  </a>
</div>

<div class="auth-layout">
  <aside class="form-panel" style="margin: 0 auto;">
    <p class="section-label">Registro</p>
    <form id="registerForm">
      <fieldset>
        <div class="field-row">
          <div class="field-group">
            <label for="name">Nombre</label>
            <input type="text" id="first_name" name="name" required />
          </div>
          <div class="field-group">
            <label for="lastname">Apellido</label>
            <input type="text" id="last_name" name="lastname" required />
          </div>
        </div>
        <div class="field-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="field-row">
          <div class="field-group">
            <label for="age">Edad</label>
            <input type="number" id="age" name="age" />
          </div>
          <div class="field-group">
            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" required />
          </div>
        </div>
      </fieldset>
      <button class="btn-yellow" type="submit">
        Crear cuenta
      </button>
    </form>
    <div class="page-nav" style="margin-top: 15px;">
      <a href="/login" class="page-nav-link">
        Ya tengo cuenta →
      </a>
    </div>
  </aside>
</div>

<script>
  const form = document.getElementById("registerForm");
  form.addEventListener("submit", async (e) => { e.preventDefault(); const data
  = { name: form.name.value, lastname: form.lastname.value, email:
  form.email.value, age: form.age.value, password: form.password.value }; const
  res = await fetch("/api/sessions/register", { method: "POST", headers: {
  "Content-Type": "application/json" }, body: JSON.stringify(data) }); const
  result = await res.json(); if (result.user) { alert("Usuario creado");
  window.location.href = "/login"; } else { alert("Error al registrarse"); } });
</script>