<div class="home-header">
  <span class="eyebrow"></span>
  <h1>Productos</h1>
  <button class="btn-secondary" onclick="goToCart()" style="margin-top: 20px; width: auto;">
    Ver carrito
  </button>
</div>

<div class="page-nav">
  <a href="/realtimeproducts" class="page-nav-link">
    Gestionar productos →
  </a>
</div>

<div class="filters">
  <form class="filters-form" id="filtersForm" method="GET" action="/products">
    <input
      type="text"
      name="query"
      id="filterQuery"
      placeholder="Buscar por título..."
      value="{{activeQuery}}"
      class="filter-input"
      autocomplete="off"
    />
    <select name="category" id="filterCategory" class="filter-select">
      <option value="">Todas las categorías</option>
      {{#each categories}}
        <option value="{{this}}" {{#if (eq this ../activeCategory)}}selected{{/if}}>{{this}}</option>
      {{/each}}
    </select>
    <select name="status" id="filterStatus" class="filter-select">
      <option value="">Disponibilidad</option>
      <option value="true" {{#if (eq activeStatus "true")}}selected{{/if}}>Activo</option>
      <option value="false" {{#if (eq activeStatus "false")}}selected{{/if}}>Inactivo</option>
    </select>
    <select name="sort" id="filterSort" class="filter-select">
      <option value="">Sin orden</option>
      <option value="asc" {{#if (eq sort "asc")}}selected{{/if}}>Precio ↑</option>
      <option value="desc" {{#if (eq sort "desc")}}selected{{/if}}>Precio ↓</option>
    </select>

    <button type="submit" class="btn-filter">Filtrar</button>
  </form>
</div>

<section class="product-list-section">
  <div class="product-list-header">
    <span class="col-num">#</span>
    <span class="col-title">Producto</span>
    <span class="col-category">Categoría</span>
    <span class="col-stock">Stock</span>
    <span class="col-price">Precio</span>
    <span></span>
  </div>
  <ul class="product-list" id="productList">
    {{#each products}}
    <li class="product-row"> 
      <span class="col-num"></span>
      <div class="col-title">
        <a href="/products/{{this._id}}" class="product-row-title">
          {{this.title}}
        </a>
        <span class="product-row-desc">
          {{this.description}}
        </span>
      </div>

      <span class="col-category">
        <span class="category-tag">
          {{this.category}}
        </span>
      </span>

      <span class="col-stock">
        <span class="stock-value {{#if (gt this.stock 10)}}stock-ok{{else}}stock-low{{/if}}">
          {{this.stock}}
        </span>
      </span>

      <span class="col-price">
        ${{formatPrice this.price}}
      </span>
      <form method="POST" action="/carts/{{../cartId}}/products/{{this._id}}">
        <input type="hidden" name="redirectTo" value="/products" />
        <button type="submit" class="btn-add-row">+</button>
      </form>
    </li>
    {{else}}
    <li class="list-empty-state">
      <p>No hay productos disponibles.</p>
    </li>
    {{/each}}
  </ul>
</section>

<div class="pagination">
  {{#if hasPrevPage}}
    <a href="{{prevLink}}" class="page-btn">
      ← Anterior
    </a>
  {{/if}}
  <span class="page-number">
    Página {{page}}
  </span>
  {{#if hasNextPage}}
    <a href="{{nextLink}}" class="page-btn">
      Siguiente →
    </a>
  {{/if}}
</div>

<script src="/js/productDetail.js"></script>
<script src="/js/toast.js"></script>
<script>
  const CART_ID = "{{cartId}}";
</script>