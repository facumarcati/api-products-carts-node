<div class="home-header">
  <span class="eyebrow"></span>
  <h1>Productos</h1>
  <div class="home-header-actions">
    <button class="btn-secondary" onclick="goToCart()">Ver carrito</button>
    <div id="authButtons"></div>
  </div>
  <div id="adminLink"></div>
</div>

<div class="page-nav">
  <div id="adminLink"></div>
</div>

<div class="filters">
  <form class="filters-form" id="filtersForm" method="GET" action="/products">
    <input
      type="text"
      name="query"
      id="filterQuery"
      placeholder="Buscar por título..."
      value="{{activeQuery}}"
      class="filter-input"
      autocomplete="off"
    />
    <select name="category" id="filterCategory" class="filter-select">
      <option value="">Todas las categorías</option>
      {{#each categories}}
        <option value="{{this}}" {{#if (eq this ../activeCategory)}}selected{{/if}}>{{this}}</option>
      {{/each}}
    </select>
    <select name="status" id="filterStatus" class="filter-select">
      <option value="">Disponibilidad</option>
      <option value="true" {{#if (eq activeStatus "true")}}selected{{/if}}>Activo</option>
      <option value="false" {{#if (eq activeStatus "false")}}selected{{/if}}>Inactivo</option>
    </select>
    <select name="sort" id="filterSort" class="filter-select">
      <option value="">Sin orden</option>
      <option value="asc" {{#if (eq sort "asc")}}selected{{/if}}>Precio ↑</option>
      <option value="desc" {{#if (eq sort "desc")}}selected{{/if}}>Precio ↓</option>
    </select>

    <button type="submit" class="btn-filter">Filtrar</button>
    <a href="/products" class="btn-filter-clear">✕ Limpiar</a>
  </form>
</div>

<section class="product-list-section" style="counter-reset: product-counter {{offset}};">
  <div class="product-list-header">
    <span class="col-num">#</span>
    <span class="col-title">Producto</span>
    <span class="col-category">Categoría</span>
    <span class="col-stock">Stock</span>
    <span class="col-price">Precio</span>
    <span></span>
  </div>
  <ul class="product-list" id="productList">
    {{#each products}}
    <li class="product-row"> 
      <span class="col-num">{{this.rowNumber}}</span>
      <div class="col-title">
        <a href="/products/{{this._id}}" class="product-row-title">
          {{this.title}}
        </a>
        <span class="product-row-desc">{{this.description}}</span>
        <span class="product-status {{#if this.status}}active{{else}}inactive{{/if}}">
          {{#if this.status}}Activo{{else}}Inactivo{{/if}}
        </span>
      </div>

      <span class="col-category">
        <span class="category-tag">
          {{this.category}}
        </span>
      </span>

      <span class="col-stock">
        <span class="stock-value {{#if (gt this.stock 10)}}stock-ok{{else}}stock-low{{/if}}">
          {{this.stock}}
        </span>
      </span>

      <span class="col-price">
        ${{formatPrice this.price}}
      </span>
      <button 
          type="button" 
          class="btn-add-row" 
          onclick="addToCart('{{this._id}}')"
        >+</button>
    </li>
    {{else}}
    <li class="list-empty-state">
      <p>No hay productos disponibles.</p>
    </li>
    {{/each}}
  </ul>
</section>

<div class="pagination">
  {{#if hasPrevPage}}
    <a href="{{prevLink}}" class="page-btn">
      ← Anterior
    </a>
  {{/if}}
  <span class="page-number">
    Página {{page}}
  </span>
  {{#if hasNextPage}}
    <a href="{{nextLink}}" class="page-btn">
      Siguiente →
    </a>
  {{/if}}
</div>

<script src="/js/productDetail.js"></script>
<script src="/js/toast.js"></script>
<script>
  const CART_ID = "{{cartId}}";
  const token = localStorage.getItem("token");

  // Un solo fetch para auth + admin
  async function initSession() {
    const authDiv = document.getElementById("authButtons");

    if (!token) {
      authDiv.innerHTML = `<a href="/login" class="btn-secondary">Login</a>`;
      return;
    }

    authDiv.innerHTML = `<button onclick="logout()" class="btn-secondary">Cerrar sesión</button>`;

    const res = await fetch("/api/sessions/current", {
      headers: { Authorization: "Bearer " + token }
    });

    if (!res.ok) return;

    const { user } = await res.json();

    if (user.role === "admin") {
      document.getElementById("adminLink").innerHTML = `
        <a href="/realtimeproducts" class="page-nav-link">Gestionar productos →</a>
      `;
    }
  }

  function logout() {
    localStorage.removeItem("token");
    window.location.href = "/login";
  }

  function goToCart() {
    window.location.href = `/carts/${CART_ID}`;
  }

  initSession();
</script>